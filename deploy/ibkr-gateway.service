[Unit]
Description=IBKR Gateway broker (stateless Node service)
Documentation=https://github.com/bogdanripa/ibkr-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ibkr-gateway
EnvironmentFile=/etc/ibkr-gateway.env
ExecStart=/usr/bin/npx tsx src/index.ts
Restart=on-failure
RestartSec=5

# Hardening (modest; we still need outbound HTTPS to IBKR + GCP, and
# Playwright spawns a headless Chromium subprocess during signIn).
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

# Drop credentials from process arguments / environment in /proc.
ProtectProc=invisible

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ibkr-gateway

[Install]
WantedBy=multi-user.target
