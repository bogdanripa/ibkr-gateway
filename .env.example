# GCP project id (required)
GCP_PROJECT_ID=auto-trader-493814

# HTTP listen port for the proxy (Caddy reverse-proxies to this)
PORT=8080

# Local-dev only: path to a service-account JSON key.
# On the VM, leave this unset — the VM's attached service account is used automatically.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Firebase web app config (client-side, public per Firebase docs).
# These are inlined into the HTML served by /console. They are PUBLIC
# values but not committed to git — copy from Firebase Console →
# Project Settings → Your apps → Web app → SDK setup and configuration.
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
