# GCP project id (required)
GCP_PROJECT_ID=auto-trader-493814

# Firestore region (informational; client picks up from project)
FIRESTORE_LOCATION=europe-west3

# HTTP listen port for the proxy (Caddy reverse-proxies to this)
PORT=8080

# Local-dev only: path to a service-account JSON key.
# On the VM, leave this unset — the VM's attached service account is used automatically.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
