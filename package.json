{
  "name": "ibkr-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "IBKR Gateway broker (session pool + API key proxy)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "seed": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/seed.ts",
    "smoke": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/smoke.ts",
    "smoke:http": "bash scripts/smoke-http.sh",
    "test:secrets": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/test-secrets.ts",
    "test": "npm run typecheck && npm run scan && npm run smoke && npm run smoke:http",
    "upload-credential": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/upload-credential.ts",
    "test:gateway": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/test-gateway.ts",
    "reap": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/reap-gateway.ts",
    "scan": "bash scripts/scan-secrets.sh",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.10.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
